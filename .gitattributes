* text=auto

# Repository source and documentation use stable LF endings on every platform.
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.webmanifest text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.npmrc text eol=lf

# Native Windows launchers retain conventional CRLF endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never pass through text conversion.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
